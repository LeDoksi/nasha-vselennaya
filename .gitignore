# Личные файлы (плеер в приложении убран, папка больше не используется — но
# если тут что-то лежит, в git это всё равно не попадёт)
music/

# Системные файлы
Thumbs.db
Desktop.ini
.DS_Store

# Скриншоты ручных проверок из браузера
browser_*.png

# Dev-инструменты. Черновые остаются локальными, инфраструктура редизайна —
# в репозитории: без стенда и съёмщика редизайн нечем проверить, а без
# fetch-fonts.js через год никто не вспомнит, откуда взялись woff2 в fonts/.
tools/*.png
tools/patch-dnd.js
tools/browser-check-results.txt

# Скриншоты прогонов — локальные. В git уходят только выводы (README, metrics).
docs/superpowers/baseline/**/*.png

# Temporary debug scripts (not for the repo)
tmp-*.js

# Секреты — никогда не коммитить
secrets.js
.env
.env.*

# Dev-зависимости (ESLint/Prettier/husky) — ставятся через npm install
node_modules/

# Минифицированный продакшен-бандл (Фаза 5) — генерируется node build.js
# заново локально и в CI/деплое, коммитить нечитаемый минифицированный diff
# смысла нет (в отличие от app.js — тот коммитим, чтобы CI проверял
# консистентность со src/, см. .github/workflows/ci.yml).
app.min.js

# Отчёт покрытия тестов (Фаза 5, npm run coverage) — генерируется заново
coverage/
docs/superpowers/baseline/lh-*.json
